NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# AI providers (fallback chain: Gemini -> Groq -> OpenRouter)
# Get keys at: https://aistudio.google.com, https://console.groq.com, https://openrouter.ai/keys
GOOGLE_AI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: Firebase service account (JSON) for server-side rate limiting +
# memory storage. Get it from Firebase Console -> Project Settings -> Service accounts.
# Then "Generate new private key" and paste the JSON here as a single line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
