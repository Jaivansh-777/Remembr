NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# AI providers (fallback chain: Gemini -> Groq -> OpenRouter -> Claude -> DeepSeek -> openrouter/free)
# Get keys at: https://aistudio.google.com, https://console.groq.com, https://openrouter.ai/keys
GOOGLE_AI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional secondary OpenRouter key used automatically when the primary is exhausted.
OPENROUTER_API_KEY_FALLBACK=your_openrouter_fallback_api_key
# Ultimate fallback — the openrouter/free router. If unset, the primary
# OPENROUTER_API_KEY is used for the /free router too.
OPENROUTER_FREE_API_KEY=your_openrouter_free_api_key
# Optional priorities 4-5 (only activate when set):
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-3-5-haiku-latest
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Firebase service account (JSON) for server-side rate limiting +
# memory storage. Get it from Firebase Console -> Project Settings -> Service accounts.
# Then "Generate new private key" and paste the JSON here as a single line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --- Payments (UPI) ---
# UPI ID shown on the QR code. Amount in INR for the Pro plan.
NEXT_PUBLIC_UPI_ID=remembr@fam
NEXT_PUBLIC_PLAN_AMOUNT=199

# Admin (Firebase UID of the person who verifies payments and reaches /admin).
# Find your UID in Firebase Console -> Authentication -> Users, or use
# requireAuth in any route and log auth.user.uid. MUST be set for the admin
# panel + verify endpoints to work.
ADMIN_UID=your_firebase_uid

# --- Free-trial abuse protection ---
# Max distinct free accounts that can be created from a single IP before a new
# signup is blocked (fingerprint/IP check on sign-in).
MAX_FREE_USERS_PER_IP=3
# Cross-session memories a free account can store before it must upgrade.
FREE_TRIAL_MEMORIES=5
# Optional: Resend API key + sender for upgrade confirmation emails.
# Leave empty to disable emails (upgrades still apply server-side).
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Remembr <onboarding@resend.dev>
